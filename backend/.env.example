# Copy to .env and fill in.

# Port the Express backend listens on.
PORT=8787

# Groq API key, powers both agents (Instamart chat + Food dish-discovery).
# Get one at https://console.groq.com
GROQ_API_KEY=

# Optional override — defaults to openai/gpt-oss-120b (Groq's current
# recommended tool-use model). Groq's supported-model list shifts over time;
# check https://console.groq.com/docs/models if this stops working.
GROQ_MODEL=

# Optional override for the vision model used by "import from a screenshot".
# Defaults to qwen/qwen3.6-27b (Groq's current multimodal model — the
# original default, a Llama-4 Scout build, was retired by Groq without
# notice; check https://console.groq.com/docs/models if this stops working
# again). Must be a vision-capable model — the default GROQ_MODEL is not.
GROQ_VISION_MODEL=

# Optional. Grounds the "order things for X" recipe flow in a real recipe
# from the web (instead of the model's own recall) and powers the per-item
# "Explain" popup. Get a free-tier key at https://tavily.com — both features
# degrade gracefully to their pre-web-search behavior if this is left blank.
TAVILY_API_KEY=

# Where this backend runs, used to build the OAuth redirect_uri.
# Must be an exact-match localhost URI registered with Swiggy's OAuth server.
BACKEND_ORIGIN=http://localhost:8787

# Where the Vite dev server runs. After OAuth completes, the backend
# bounces the browser back here.
FRONTEND_ORIGIN=http://localhost:5173
