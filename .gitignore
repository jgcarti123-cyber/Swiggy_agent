# Dependencies
node_modules/

# Secrets — never commit real env files, only the .env.example templates
.env
.env.*
!.env.example

# SQLite DB — holds the live Swiggy OAuth access token server-side, must
# never be committed. See CLAUDE.md: "Store the token server-side only."
**/data/*.db
**/data/*.db-journal
**/data/*.db-wal
**/data/*.db-shm

# Build output
dist/
dist-ssr/

# Logs
logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.local

# Original Cabinet Grotesk vendor drop (OTF/TTF/EOT/WOFF for every weight,
# ~1.9MB). The app loads exactly one file from it — the variable woff2 — which
# is committed at frontend/public/fonts/ alongside the FFL license.
CabinetGrotesk_Complete/

# Temporary cart diagnostic (see backend/src/cartAudit.js)
backend/data/cart-audit.log

# Local scratch notes (dev-server start commands)
note.txt
